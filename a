      const ingredientsList = info.extendedIngredients
      .map((ing) => `- ${ing.original}`)
      .join('\n');

      const steps = info.analyzedInstructions?.[0]?.steps || [];
    const instructionsList = steps.length
      ? steps.map((step, idx) => `${idx + 1}. ${step.step}`).join('\n')
      : 'Instructions not available.';


    const markdown = `## 🍽️ ${info.title}

    **Ingredients**:

     ${ingredientsList}

      **Instructions**:

      ${instructionsList}

     `


    fun(markdown);

  };


  
    async function showRecipe(){
        fetchRecipes();
    }

    const handleRemove = (indexToRemove) => {
    set(
      value.filter((_, index) => index !== indexToRemove)
    );
  };
  
    const ingredients = value.map((ingredient , index) =>
       {
           return  <li key={index}>{ingredient} <button className='remove' onClick={() => handleRemove(index)}> <i className="fa-regular fa-circle-xmark"></i></button></li>
           
       })  


  

       const scrolrecipe = useRef(null)

      useEffect(() => {
        if(num!=="" && scrolrecipe.current !=null ){
           // scrolrecipe.current.scrollIntoView({behaviour: "smooth"})
            const yCoord = scrolrecipe.current.getBoundingClientRect().top + window.scrollY
            window.scroll({
                top: yCoord,
                behavior: "smooth"
            })
        }

      }, [num]) 

    return(
        <div>
            <Head />
            <HeadForm action={signUp} />
            <List className="list" ingredients={ingredients}  />
            {ingredients.length>0 && <Article showRecipe={showRecipe}  ref={scrolrecipe} />} 
            {num && <div className="sectionRecipe">
                 <h2>Chef Claude Recommends:</h2>
                     <ReactMarkdown>
                           {num}
                     </ReactMarkdown>
              </div> }
        </div>
    )
}






import Head from './head'
import List from './List'
import { useState, useRef, useEffect } from 'react'
import { Article } from './Article'
import { HeadForm } from './HeadForm'
import RecipeList from './RecipeList'
import RecipeDetails from './RecipeDetails'
import ReactMarkdown from 'react-markdown'
import "./index.css"

export function Chef() {

    let [value, set] = useState([]);
    let [num, fun] = useState("")
    const [selectedRecipe, setSelectedRecipe] = useState(null);

    function signUp(formData) {
        const newIngredient = formData.get("ingredient");
        set(prev => [...prev, newIngredient])
    }

    const fetchRecipes = async () => {
        const apiKey = import.meta.env.VITE_MYAPI;
          const response = await fetch(
      `https://api.spoonacular.com/recipes/complexSearch?query=${value}&number=10&apiKey=${apiKey}`
    );
    const data = await response.json();
    fun(data.results);
    setSelectedRecipe(null);
  };

       const fetchRecipeDetails = async (id) => {
    const response = await fetch(
      `https://api.spoonacular.com/recipes/${id}/information?apiKey=${apiKey}`
    );
    const data = await response.json();
    setSelectedRecipe(data);
  };

    async function showRecipe() {
        fetchRecipes();
    }

    const handleRemove = (indexToRemove) => {
        set(
            value.filter((_, index) => index !== indexToRemove)
        );
    };

   

    const scrolrecipe = useRef(null);

    useEffect(() => {
        if (num !== "" && scrolrecipe.current != null) {
            const yCoord = scrolrecipe.current.getBoundingClientRect().top + window.scrollY;
            window.scroll({
                top: yCoord,
                behavior: "smooth"
            });
        }

    }, [num]);

    return (
        <div>
            <Head />
            <HeadForm action={signUp} />
            <List ingredients={value} onRemove={handleRemove}/>
            {value.length > 0 && <Article showRecipe={showRecipe} ref={scrolrecipe} />}
             {!selectedRecipe ? (
        <RecipeList recipes={num} onSelect={fetchRecipeDetails} />
      ) : (
        <RecipeDetails recipe={selectedRecipe} onBack={() => setSelectedRecipe(null)} />
      )}
        </div>
    )
}


